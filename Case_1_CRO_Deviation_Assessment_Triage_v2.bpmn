      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Activity_1hfsmdv" name="Record initial event data">
      <bpmn:documentation>RESPONSIBLE: L1, Reporting Party 
ACCOUNTABLE: QA Manager 
BRIEF DESCRIPTION: Formal entry of deviation details and observed facts into the quality system. 
INPUT: Observed operational event. 
OUTPUT: Initial Event Record. SOURCE OF RECORD: QMS-DB-01</bpmn:documentation>
      <bpmn:incoming>Flow_0eprn5b</bpmn:incoming>
      <bpmn:incoming>Flow_03l8wlz</bpmn:incoming>
      <bpmn:outgoing>Flow_04l53fg</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0iek4me">
        <bpmn:targetRef>DataObjectReference_1jaiywb</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_19yv780">
        <bpmn:targetRef>DataStoreReference_09pqnw2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:startEvent id="StartEvent_1" name="Potential deviation identified">
      <bpmn:documentation>RESPONSIBLE: L1, Reporting Party 
ACCOUNTABLE: QA Manager 
BRIEF DESCRIPTION: Identification of an operational event potentially deviating from GxP standards. 
OUTPUT: Process trigger.</bpmn:documentation>
      <bpmn:outgoing>Flow_0eprn5b</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_0x5loke">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" />
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1xu71qs" name="Is it a valid deviation?">
      <bpmn:documentation>BRIEF DESCRIPTION: Routing decision based on event validity. 
DECISION CRITERIA: "Yes" leads to Impact Assessment; "No" leads to Event Dismissal.</bpmn:documentation>
      <bpmn:incoming>Flow_1ysrid3</bpmn:incoming>
      <bpmn:outgoing>Flow_0dajbu2</bpmn:outgoing>
      <bpmn:outgoing>Flow_1uwz7rn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_0brq2b4" name="Assess scientific impact &#38; issue record">
      <bpmn:documentation>RESPONSIBLE: L2, Lead Scientist 
ACCOUNTABLE: Lead Scientist 
BRIEF DESCRIPTION: In-depth scientific evaluation of the deviation's effect on data integrity and patient safety. INPUT: Validated deviation status. 
OUTPUT: Deviation Impact Record. 
BUSINESS RULE: Must identify specific data gaps or mismatches.</bpmn:documentation>
      <bpmn:incoming>Flow_0dajbu2</bpmn:incoming>
      <bpmn:outgoing>Flow_0907im4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_166sl8r">
        <bpmn:targetRef>DataObjectReference_1rwdyyc</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0v76kas">
        <bpmn:targetRef>DataStoreReference_09pqnw2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Event_14jjktu" name="Compliance Alert sent to QA">
      <bpmn:documentation>BRIEF DESCRIPTION: Notification of non-compliance with the initial reporting SLA.</bpmn:documentation>
      <bpmn:incoming>Flow_02zoki2</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0pvuiiv" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="Activity_0ht5s1e" name="Close deviation case">
      <bpmn:documentation>RESPONSIBLE: L2, Lead Scientist 
ACCOUNTABLE: QA Manager 
BRIEF DESCRIPTION: Administrative closure and archival of the dismissed event.</bpmn:documentation>
      <bpmn:incoming>Flow_0uw5cd9</bpmn:incoming>
      <bpmn:outgoing>Flow_0xw1fq9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_0e9lfm8" name="Event dismissed (No deviation)">
      <bpmn:documentation>BRIEF DESCRIPTION: Final notification to stakeholders that the event is dismissed.</bpmn:documentation>
      <bpmn:incoming>Flow_0xw1fq9</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0s3qosj" />
    </bpmn:endEvent>
    <bpmn:task id="Activity_0f9ju59" name="Send Deviation Impact Record">
      <bpmn:documentation>RESPONSIBLE: L2, Lead Scientist 
ACCOUNTABLE: QA Manager 
BRIEF DESCRIPTION: Handover of the completed scientific impact evaluation to the Triage phase. 
INPUT: Deviation Impact Record.</bpmn:documentation>
      <bpmn:incoming>Flow_0907im4</bpmn:incoming>
      <bpmn:outgoing>Flow_1aokari</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="DataStoreReference_09pqnw2" name="QMS ALCOA+ and Swissmedic standards- compliant">
      <bpmn:documentation>BRIEF DESCRIPTION: Centralized Quality Management System database. 
BUSINESS RULE: All GxP records must synchronize to this store for ALCOA+ compliance.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:task id="Activity_0sk1ez6" name="Validate deviation">
      <bpmn:documentation>RESPONSIBLE: L2, Lead Scientist 
ACCOUNTABLE: Lead Scientist 
BRIEF DESCRIPTION: Formal verification of the reported incident to confirm a regulatory or technical deviation. 
INPUT: Initial Event Record. 
BUSINESS RULE: Must determine validity before proceeding to scientific assessment. SOURCE OF RECORD: QMS-DB-01</bpmn:documentation>
      <bpmn:incoming>Flow_04l53fg</bpmn:incoming>
      <bpmn:outgoing>Flow_1ysrid3</bpmn:outgoing>
      <bpmn:property id="Property_14ligsi" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1pozgm1">
        <bpmn:sourceRef>DataStoreReference_09pqnw2</bpmn:sourceRef>
        <bpmn:targetRef>Property_14ligsi</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Event_12jhju1" name="Escalate to  Management">
      <bpmn:documentation>BRIEF DESCRIPTION: Signal to management indicating a bottleneck in the validation stage.</bpmn:documentation>
      <bpmn:incoming>Flow_0q9t0to</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscalationEventDefinition_0pgerz7" />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataObjectReference id="DataObjectReference_1jaiywb" name="Initial Event Record" dataObjectRef="DataObject_0uxve5y">
      <bpmn:documentation>BRIEF DESCRIPTION: Primary data capture of the potential deviation event. 
STANDARD: ALCOA+ / GxP.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_0uxve5y" />
    <bpmn:task id="Activity_0a4j08i" name="Request necessary data">
      <bpmn:documentation>RESPONSIBLE: L2, Lead Scientist ACCOUNTABLE: Lead Scientist 
BRIEF DESCRIPTION: Formal request to the Reporting Party for missing evidence or clarification. 
OUTPUT: Evidence request notification.</bpmn:documentation>
      <bpmn:incoming>Flow_0m05tv0</bpmn:incoming>
      <bpmn:outgoing>Flow_03l8wlz</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_1jquwwv" name="Finalise deviation closure record">
      <bpmn:documentation>RESPONSIBLE: L2, Lead Scientist 
ACCOUNTABLE: Lead Scientist 
BRIEF DESCRIPTION: Finalizing administrative records for events determined to be non-deviations. 
OUTPUT: Deviation Record [Closed].</bpmn:documentation>
      <bpmn:incoming>Flow_1uwz7rn</bpmn:incoming>
      <bpmn:outgoing>Flow_0uw5cd9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1gec2ui">
        <bpmn:targetRef>DataStoreReference_09pqnw2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1pf0qwv">
        <bpmn:targetRef>DataObjectReference_1h473i3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="DataObjectReference_1h473i3" name="Deviation Record [Closed]" dataObjectRef="DataObject_0s5jtbf">
      <bpmn:documentation>BRIEF DESCRIPTION: Final state-specific records documenting the triage outcome and next actions. 
STANDARD: ALCOA+ / GxP.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_0s5jtbf" />
    <bpmn:endEvent id="Event_1jhu548" name="Standard RCA initiated">
      <bpmn:documentation>BRIEF DESCRIPTION: Final state for major incidents transitioning to a full RCA.</bpmn:documentation>
      <bpmn:incoming>Flow_0p2bmlk</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0hf3vne" />
    </bpmn:endEvent>
    <bpmn:task id="Activity_0d7ey5t" name="Trigger emergency escalation">
      <bpmn:documentation>RESPONSIBLE: L3, QA Manager 
ACCOUNTABLE: QA Manager 
BRIEF DESCRIPTION: Activation of the emergency response protocol for high-risk events. 
OUTPUT: Deviation Record [Escalated].</bpmn:documentation>
      <bpmn:incoming>Flow_074bkzg</bpmn:incoming>
      <bpmn:outgoing>Flow_1u7jt2i</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0f4mjel">
        <bpmn:targetRef>DataObjectReference_1m2l6kg</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1vhqksr">
        <bpmn:targetRef>DataStoreReference_0019rf6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Activity_07jgk2o" name="Notify Sponsor within 24 hours">
      <bpmn:documentation>RESPONSIBLE: L3, QA Manager 
ACCOUNTABLE: QA Manager 
BRIEF DESCRIPTION: Execution of mandatory sponsor notification for critical incidents. 
BUSINESS RULE: Notification must be completed within 24 hours of triage.</bpmn:documentation>
      <bpmn:incoming>Flow_1u7jt2i</bpmn:incoming>
      <bpmn:outgoing>Flow_13xmfct</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_1xwcj1t">
      <bpmn:documentation>BRIEF DESCRIPTION: Routing decision based on the assigned risk level. 
DECISION CRITERIA: Critical (Escalation), Major (Investigation), or Minor (Closure).</bpmn:documentation>
      <bpmn:incoming>Flow_11lz3qo</bpmn:incoming>
