  <bpmn:process id="Process_1oiavf3" name="New BPMN diagram" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0sxiybp">
      <bpmn:lane id="Lane_1dy5zjt" name="Reporting Party (L1)">
        <bpmn:flowNodeRef>Activity_1hfsmdv</bpmn:flowNodeRef>
